# Vite env for Playwright end-to-end runs (`vite --mode e2e`).
#
# Precedence note: Vite loads `.env.[mode]` ABOVE `.env.local`, so the blank
# Supabase values here deliberately override the real credentials in
# `.env.local`. That is the whole point of this file:
#
#   - `isSupabaseConfigured` becomes false (src/lib/supabase.js)
#   - the router auth guard turns into a no-op (src/router/index.js)
#   - no store ever reaches a real backend
#
# The result is a fully local, deterministic app the tests can drive without a
# Supabase project, a test user, or network access.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Pin the API origin so every backend call has one predictable absolute URL for
# `page.route()` to intercept, in both `vite` and `vite preview`. Nothing is
# expected to listen on this port during tests - unmocked calls should fail
# loudly rather than silently hit a real server.
VITE_API_BASE=http://127.0.0.1:3001
